# ==============================================================================
# VERIDEGREE X — Backend REST API Environment Configuration
# ==============================================================================

# Server Port & Environment
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veridegree_x?schema=public

# JWT Authentication Configuration
JWT_SECRET=veridegree_x_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# File Storage & Cryptographic Encryption
# DOCUMENT_ENCRYPTION_KEY must be a 64-character hex string (32 bytes) for AES-256-GCM
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PRIVATE_STORAGE_PATH=./storage/credentials

# Ethereum Sepolia Blockchain RPC & Registry
SEPOLIA_RPC_URL=https://rpc.sepolia.org
REGISTRY_CONTRACT_ADDRESS=0x98D5a89f0fbdCD2Af870380fE5094d833Fd60dCc

